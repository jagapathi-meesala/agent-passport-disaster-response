# Disaster Response Agent - Environment Configuration Template
# Copy this file to .env and fill in environment-specific values.

# General Environment Settings
ENVIRONMENT=
LOG_LEVEL=

# API Server Configuration
API_HOST=
API_PORT=

# Agent Identity & Passport Configuration
AGENT_PASSPORT_ID=
AGENT_ISSUER_PUBLIC_KEY=
PASSPORT_FILE_PATH=

# LLM / Model Endpoint Settings (Inject at runtime)
MODEL_PROVIDER=
MODEL_ENDPOINT_URL=
MODEL_API_KEY=

# External Services / Disaster Tools (Configured per deployment)
WEATHER_SERVICE_URL=
WEATHER_API_KEY=
WEATHER_TIMEOUT_SECONDS=
RESOURCE_SERVICE_URL=
RESOURCE_API_KEY=
RESOURCE_TIMEOUT_SECONDS=
LOGISTICS_API_KEY=
SHELTER_DB_URI=

